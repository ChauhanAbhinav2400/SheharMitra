# All values are backend runtime settings. Never copy secrets into NEXT_PUBLIC_ variables.
NODE_ENV=development
PORT=4000
API_ORIGIN=http://localhost:4000
FRONTEND_ORIGINS=http://localhost:3000
TRUST_PROXY_HOPS=0
COOKIE_SAME_SITE=lax
# Production requires 32+ random characters. Local development generates .data/session.key.
SESSION_SECRET=
DATABASE_ADAPTER=local
DATA_FILE=./.data/sheharmitra.json
# Mongo requires a replica set for transactions; required when DATABASE_ADAPTER=mongo.
MONGODB_URI=
# Local demo accounts only; leave blank to use the documented local demo password.
DEMO_PASSWORD=
# Integer paise/grams; pilot goods limit is ₹5,000, per-parcel limit is 20 kg.
PLATFORM_FEE_PAISE=0
PILOT_MAX_VALUE_PAISE=500000
PILOT_MAX_WEIGHT_GRAMS=20000
OTP_PROVIDER=demo
# firebase uses verified client ID tokens; webhook sends {phone,code,expiresInSeconds}; disabled blocks new registrations.
OTP_WEBHOOK_URL=
OTP_WEBHOOK_TOKEN=
STORAGE_ADAPTER=local
UPLOAD_DIR=./.data/uploads
S3_REGION=ap-south-1
S3_BUCKET=sheharmitra
S3_ENDPOINT=
# Leave both AWS fields blank to use the SDK credential chain / IAM role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Calling needs either Cloudflare TURN credentials below or coturn URLs and a shared secret.
STUN_URLS=
TURN_URLS=
TURN_SHARED_SECRET=

DEMO_SEED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
TURN_PROVIDER=cloudflare
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# Address matching / notifications and review defaults
GEOCODING_PROVIDER=geoapify
GEOAPIFY_API_KEY=
MATCH_PROXIMITY_KM=3
MATCH_TIME_WINDOW_MINUTES=15
DISPUTE_WINDOW_HOURS=48
DISPUTE_RESPONSE_HOURS=48
